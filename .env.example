# Copy to .env.local for local development against the Firebase emulators.
GCLOUD_PROJECT=demo-afh
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-afh.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-afh
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

SMTP_HOST=localhost
SMTP_PORT=1025
APP_URL=http://localhost:3000

# Any value locally; call the morning job with: curl -X POST -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/morning
CRON_SECRET=local-secret

# Optional: real Gemini prompts locally (needs `gcloud auth application-default login`).
# Leave unset to use the hand-written list.
# GOOGLE_CLOUD_PROJECT=fir-wellness-f833d
